{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "vhabitat",
  "compatibility_date": "2026-10-28",
  "build": {
    "command": "hugo --minify"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [{ "pattern": "vhabitat.shortarrow.jp", "zone_name": "shortarrow.jp", "custom_domain": true }]
}
